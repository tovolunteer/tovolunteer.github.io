---
const { t, page, title } = Astro.props;
const base = import.meta.env.BASE_URL;
const prefix = t.lang === 'zh' ? `${base}zh/` : base;
const otherPrefix = t.lang === 'zh' ? base : `${base}zh/`;
const suffix = page === 'home' ? '' : `${page}/`;
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.intro} />
    <title>{title} | {t.name}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={prefix} aria-label={t.name}>
          <span class="brand-mark" aria-hidden="true">✳</span>
          <span>{t.name}</span>
        </a>
        <nav aria-label={t.navLabel}>
          <a href={prefix} aria-current={page === 'home' ? 'page' : undefined}>{t.home}</a>
          <a href={`${prefix}foodbanks/`} aria-current={page === 'foodbanks' ? 'page' : undefined}>{t.foodbanks}</a>
          <a href={`${prefix}about/`} aria-current={page === 'about' ? 'page' : undefined}>{t.about}</a>
          <a class="language-link" href={`${otherPrefix}${suffix}`} hreflang={t.lang === 'zh' ? 'en' : 'zh'}>{t.switchLanguage}</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <div class="footer-actions">
          <a class="button-link" href="https://github.com/tovolunteer/tovolunteer.github.io/issues/new?template=suggest.yml" target="_blank" rel="noopener noreferrer">{t.suggest}</a>
          <a class="button-link secondary" href="https://github.com/tovolunteer/tovolunteer.github.io/issues/new?template=report.yml" target="_blank" rel="noopener noreferrer">{t.report}</a>
        </div>
        <p>{t.footer}</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root { color-scheme: light dark; font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #f4f7f4; color: #19332b; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; min-width: 0; }
  a { color: #166c54; text-underline-offset: .2em; }
  a:hover { text-decoration-thickness: 2px; }
  .site-shell { max-width: 1120px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 40px); }
  .site-header { display: flex; justify-content: space-between; align-items: center; gap: 18px; padding: 22px 0; border-bottom: 1px solid #cbd9d0; }
  .brand { display: inline-flex; align-items: center; gap: 9px; color: inherit; font-weight: 800; font-size: 1.15rem; text-decoration: none; line-height: 1.2; }
  .brand-mark { display: grid; place-items: center; flex: none; width: 34px; height: 34px; border-radius: 11px; background: #147c5f; color: white; font-size: 1.45rem; }
  nav { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 18px; }
  nav a { color: inherit; font-size: .92rem; font-weight: 650; text-decoration: none; white-space: nowrap; }
  nav a[aria-current="page"] { color: #126b50; text-decoration: underline; text-decoration-thickness: 2px; }
  .language-link { border: 1px solid #a2b8a9; border-radius: 999px; padding: 5px 12px; }
  main { padding-bottom: 36px; }
  h1, h2, h3, p { overflow-wrap: anywhere; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.5rem); line-height: 1.1; letter-spacing: -.04em; margin: 0 0 12px; }
  h2 { font-size: 1.5rem; letter-spacing: -.025em; margin: 0; }
  h3 { font-size: 1.125rem; font-weight: 600; line-height: 1.5; margin: 0 0 14px; }
  .hero { padding: clamp(22px, 3.5vw, 44px) 0 21px; }
  .eyebrow { color: #14684f; text-transform: uppercase; font-size: .72rem; font-weight: 800; letter-spacing: .13em; margin: 0 0 10px; }
  .lead { font-size: 1rem; color: #4a6155; line-height: 1.55; max-width: 640px; margin: 0; }
  .content-section { padding: 34px 0 48px; border-top: 1px solid #cbd9d0; }
  .section-heading { margin-bottom: 22px; }
  .section-heading p { color: #53695e; font-size: .92rem; line-height: 1.55; max-width: 700px; margin: 10px 0 0; }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 310px), 1fr)); gap: 14px; }
  .card { min-width: 0; padding: 18px; border: 1px solid #d3e0d7; border-radius: 16px; background: #fff; box-shadow: 0 5px 18px #1c503009; }
  .card h3 a { color: inherit; }
  .card p { line-height: 1.55; }
  .card-meta { display: grid; gap: 9px; margin: 0 0 16px; line-height: 1.5; }
  .card-meta div { display: grid; grid-template-columns: minmax(74px, 32%) minmax(0, 1fr); gap: 8px; }
  .card-meta dt { font-size: .8rem; font-weight: 600; color: #526b5e; }
  .card-meta dd { margin: 0; font-size: 1rem; overflow-wrap: anywhere; }
  .card-meta .key dd { font-weight: 700; }
  .card-meta .key dd a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .card-meta .minor dt, .card-meta .minor dd { font-size: .8rem; }
  .card-meta .minor dd { color: #526b5e; }
  .card-meta .minor { gap: 4px 8px; }
  .card-actions { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 18px; font-weight: 700; }
  .tag { display: inline-block; border-radius: 999px; padding: 4px 10px; background: #e5f3e8; color: #155c43; font-size: .77rem; font-weight: 750; margin-bottom: 13px; }
  .season-tag { display: inline-block; border-radius: 999px; padding: 4px 10px; margin: 0 6px 13px 0; font-size: .77rem; font-weight: 750; background: #e7ece8; color: #3f584b; }
  .season-tag.open { background: #d9f2df; color: #17613c; }
  .season-tag.seasonal { background: #edf0ee; color: #53675b; }
  .muted { color: #53695e; }
  .empty { border: 1px dashed #a7bbac; border-radius: 14px; padding: 24px; color: #53695e; }
  .notice { border-left: 4px solid #bd7840; background: #fff0da; color: #593b23; padding: 10px 14px; border-radius: 5px; margin-bottom: 18px; }
  .footer-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; }
  .button-link { display: inline-block; padding: 8px 14px; border-radius: 999px; background: #1f6b45; color: #fff; font-weight: 700; text-decoration: none; }
  .button-link.secondary { background: transparent; color: inherit; border: 1px solid currentColor; }
  .site-footer { border-top: 1px solid #cbd9d0; padding: 24px 0 40px; color: #53695e; font-size: .88rem; }
  @media (max-width: 620px) { .site-header { align-items: flex-start; flex-direction: column; } nav { gap: 8px 14px; } }
  @media (prefers-color-scheme: dark) {
    :root { background: #10221b; color: #e8f5e9; }
    a, nav a[aria-current="page"] { color: #8de0b3; }
    .site-header, .content-section, .site-footer { border-color: #365447; }
    .brand, nav a { color: #e8f5e9; }
    .brand-mark { background: #257e62; }
    .language-link { border-color: #688b78; }
    .eyebrow { color: #90dfb2; }
    .lead, .section-heading p, .muted, .card-meta dt, .card-meta .minor dd, .site-footer { color: #b4cdbb; }
    .card { background: #1b3328; border-color: #365447; box-shadow: none; }
    .tag { background: #28533d; color: #c2f0ce; }
    .season-tag { background: #33483d; color: #d2e0d5; }
    .season-tag.open { background: #24573c; color: #b8f0c9; }
    .season-tag.seasonal { background: #344139; color: #c6d3ca; }
    .empty { color: #b4cdbb; border-color: #688b78; }
    .notice { background: #463823; color: #ffdda5; border-color: #d99853; }
  }
</style>
