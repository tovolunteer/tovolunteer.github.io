---
import Layout from './Layout.astro';
import DistanceSort from './DistanceSort.astro';
import { loadData } from '../lib/data.mjs';
import { coordinatesOf, mapUrl } from '../lib/geo.mjs';

const { t } = Astro.props;
const { foodbanks, places } = await loadData();
const age = (value) => value == null ? t.ageUnknown : t.ageAtLeast.replace('{age}', String(value));
---
<Layout t={t} page="foodbanks" title={t.foodbanksTitle}>
  <section class="hero">
    <p class="eyebrow">{t.foodEyebrow}</p>
    <h1>{t.foodbanksTitle}</h1>
    <p class="lead">{t.foodbanksIntro}</p>
    <div class="directory-links">
      <a href="https://211central.ca/" target="_blank" rel="noopener noreferrer">211 Central ↗</a>
      <a href="https://www.dailybread.ca/find-a-food-bank/" target="_blank" rel="noopener noreferrer">Daily Bread ↗</a>
    </div>
  </section>
  <section class="content-section" data-distance-scope>
    {foodbanks.length ? <>
    <DistanceSort t={t} />
    <div class="card-grid" data-distance-grid>
      {foodbanks.map((bank) => (
        <article class="card" data-distance-card data-lat={coordinatesOf(places[bank.id])?.[0]} data-lng={coordinatesOf(places[bank.id])?.[1]}>
          {coordinatesOf(places[bank.id]) && <p class="distance" data-distance-value data-template={t.distance} hidden></p>}
          <h3><a href={bank.url} target="_blank" rel="noopener noreferrer">{bank.name}</a></h3>
          <dl class="card-meta">
            <div class="key"><dt>{t.area}</dt><dd>{bank.area || t.unknown}</dd></div>
            <div class="key"><dt>{t.address}</dt><dd>{mapUrl(bank.address, places[bank.id]) ? <a href={mapUrl(bank.address, places[bank.id])} target="_blank" rel="noopener noreferrer">{bank.address}</a> : bank.address || t.unknown}</dd></div>
            <div class="minor"><dt>{t.age}</dt><dd>{age(bank.volunteer_min_age)}</dd></div>
            <div class="minor"><dt>{t.verified}</dt><dd>{bank.last_verified}</dd></div>
          </dl>
          {(t.lang === 'zh' ? bank.notes_zh || bank.notes : bank.notes) &&
            <p class="muted">{t.lang === 'zh' ? bank.notes_zh || bank.notes : bank.notes}</p>}
          <div class="card-actions">
            <a href={bank.url} target="_blank" rel="noopener noreferrer">{t.website} ↗</a>
            {bank.find_food_url && <a href={bank.find_food_url} target="_blank" rel="noopener noreferrer">{t.findFood} ↗</a>}
            {bank.volunteer_url && <a href={bank.volunteer_url} target="_blank" rel="noopener noreferrer">{t.volunteer} ↗</a>}
          </div>
        </article>
      ))}
    </div></> : <p class="empty">{t.noFoodbanks}</p>}
  </section>
</Layout>

<style>
  .content-section :global(.distance-form) { margin-bottom: 18px; padding: 18px; border-radius: 14px; background: #e7f0e8; }
  .distance { color: #14684f; font-size: .88rem; font-weight: 700; margin: 0 0 12px; }
  .directory-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .directory-links a { display: inline-block; border-radius: 10px; background: #147c5f; color: white; text-decoration: none; font-weight: 750; padding: 12px 16px; }
  @media (prefers-color-scheme: dark) { .directory-links a { background: #257e62; } .content-section :global(.distance-form) { background: #234031; } .distance { color: #90dfb2; } }
</style>
