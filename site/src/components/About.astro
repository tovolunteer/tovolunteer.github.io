---
import Layout from './Layout.astro';
import { about } from '../i18n/about';

const { t } = Astro.props;
const sections = about[t.lang === 'zh' ? 'zh' : 'en'];
---
<Layout t={t} page="about" title={t.aboutTitle}>
  <section class="hero">
    <p class="eyebrow">{t.homeEyebrow}</p>
    <h1>{t.aboutTitle}</h1>
  </section>
  <section class="content-section about-grid">
    {sections.map((s) => (
      <article class="card">
        <h2>{s.title}</h2>
        {s.paras?.map((p) => <p>{p}</p>)}
        {s.bullets && <ul>{s.bullets.map((b) => <li>{b}</li>)}</ul>}
        {s.links && <p class="about-links">{s.links.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} ↗</a>)}</p>}
      </article>
    ))}
    <p class="muted">{t.geoCredit}</p>
  </section>
</Layout>

<style>
  .about-grid { display: grid; gap: 14px; }
  .about-grid h2 { font-size: 1.15rem; margin-top: 0; }
  .about-grid p, .about-grid li { line-height: 1.65; max-width: 780px; }
  .about-grid ul { padding-left: 1.2rem; margin: 8px 0 0; }
  .about-links { display: flex; flex-wrap: wrap; gap: 6px 18px; font-weight: 700; }
</style>
